<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Apos.Shapes.Example.NFMW</RootNamespace>
        <AssemblyName>AposShapesExample</AssemblyName>
        <!-- Desktop GL is x64-only on Windows for the same reason the backend is: the native SDL3
             below has to match the process, and the backend pins x64 so the two GL backends cannot
             diverge in bitness. -->
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../../Source/Apos.Shapes.NFMW.csproj" />
        <!-- For the window and the context. The device this example renders through is DesktopGL's
             rather than sokol's: desktop GL has no ownerless surface, so its "headless" mode is a
             window that is never shown, and it needs no native graphics library beyond SDL. -->
        <ProjectReference Include="..\..\..\..\NFMWorld.Graphics.DesktopGL\NFMWorld.Graphics.DesktopGL.csproj" />
        <ProjectReference Include="..\..\..\..\NFMWorld.Platform.SDL3\NFMWorld.Platform.SDL3.csproj" />
        <!-- Aliased for the reason NFMWorld.Platform.SDL3 documents: SDK-style transitive project
             references do not carry the assembly alias through, so a project that reads SDL3
             directly has to alias it again or the two copies of the SDL3.SDL type collide. -->
        <ProjectReference Include="..\..\..\..\FNA\lib\SDL3-CS\SDL3\SDL3.Core.csproj" Aliases="SDL3New" />
    </ItemGroup>

    <!-- SDL3 at the output root. The game finds it through its DllImport resolver
         (WorldGame.ImportResolver's "libs/<arch>" layout); this example has no such resolver, so
         the DLL sits next to the executable where default probing finds it. opengl32.dll needs no
         entry - it is a system library. -->
    <ItemGroup>
        <None Include="..\..\..\..\NFMWorld.NativeLibs\libs\x64\SDL3.dll" Link="SDL3.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- The font is read at run time rather than embedded, the way the other platform examples read
         theirs: baking outlines is the expensive part and it happens once, at load. -->
    <ItemGroup>
        <None Include="..\..\Content\source-code-pro-medium.ttf" Link="source-code-pro-medium.ttf" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
